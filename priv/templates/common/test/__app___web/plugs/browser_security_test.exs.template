defmodule __WEB_MODULE__.Plugs.BrowserSecurityTest do
  use ExUnit.Case, async: true
  import Plug.Conn
  import Plug.Test

  alias __WEB_MODULE__.Plugs.BrowserSecurity

  test "rejects a cross-site unsafe browser request" do
    conn =
      conn(:post, "/feedback")
      |> put_req_header("sec-fetch-site", "cross-site")
      |> BrowserSecurity.call([])

    assert conn.halted
    assert conn.status == 403
  end

  test "adds the configured browser security headers" do
    conn = BrowserSecurity.call(conn(:get, "/"), [])

    assert get_resp_header(conn, "content-security-policy") != []
    assert get_resp_header(conn, "x-content-type-options") == ["nosniff"]
  end
end
