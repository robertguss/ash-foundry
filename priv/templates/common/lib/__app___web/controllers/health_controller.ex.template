defmodule __WEB_MODULE__.HealthController do
  use __WEB_MODULE__, :controller

  def live(conn, _params), do: json(conn, %{status: "ok"})

  def ready(conn, _params) do
    if __MODULE__.Health.ready?() do
      json(conn, %{status: "ready"})
    else
      conn |> put_status(:service_unavailable) |> json(%{status: "not_ready"})
    end
  end
end
