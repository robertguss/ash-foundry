defmodule __WEB_MODULE__.Endpoint do
  use Phoenix.Endpoint, otp_app: :__APP__
  import PhoenixVite.Plug

  @secure_cookie Application.compile_env!(:__APP__, :secure_session_cookie)
  @session_options [
    store: :cookie,
    key: if(@secure_cookie, do: "__Host-__APP___session", else: "___APP___session"),
    signing_salt: "ash-foundry-signing-v1",
    encryption_salt: "ash-foundry-encryption-v1",
    same_site: "Lax",
    http_only: true,
    secure: @secure_cookie,
    max_age: 60 * 60 * 24 * 30
  ]

  plug :favicon, dev_server: {PhoenixVite.Components, :has_vite_watcher?, [__WEB_MODULE__.Endpoint]}

  plug Plug.Static,
    at: "/",
    from: :__APP__,
    gzip: not code_reloading?,
    only: __WEB_MODULE__.static_paths(),
    raise_on_missing_only: code_reloading?

  if Mix.env() == :dev and Code.ensure_loaded?(Tidewave) do
    plug Tidewave, allow_remote_access: false
  end

  if code_reloading? do
    plug Phoenix.CodeReloader
    plug AshPhoenix.Plug.CheckCodegenStatus
    plug Phoenix.Ecto.CheckRepoStatus, otp_app: :__APP__
  end

  if code_reloading? do
    plug Phoenix.LiveDashboard.RequestLogger,
      param_key: "request_logger",
      cookie_key: "request_logger"
  end

  plug __WEB_MODULE__.Plugs.RequestLimits
  plug __WEB_MODULE__.Plugs.TrustedProxy
  plug __WEB_MODULE__.Plugs.CanonicalHost
  plug Plug.RequestId
  plug Plug.Telemetry, event_prefix: [:phoenix, :endpoint]

  plug Plug.Parsers,
    parsers: [:urlencoded, :multipart, :json],
    pass: ["*/*"],
    json_decoder: Phoenix.json_library(),
    body_reader: {__MODULE__.RequestBodyReader, :read_body, []},
    length: 10_000_000

  plug Plug.MethodOverride
  plug Plug.Head
  plug Plug.Session, @session_options

  plug Sentry.PlugContext,
    body_scrubber: nil,
    cookie_scrubber: nil,
    header_scrubber: nil

  plug __WEB_MODULE__.Router
end
