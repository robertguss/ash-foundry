.shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at 80% -10%, light-dark(#e7e5ff, #25234a), transparent 36rem),
    light-dark(#f8f9fc, #11121a);
}

.header {
  backdrop-filter: blur(14px);
  background: light-dark(rgb(255 255 255 / 85%), rgb(20 21 30 / 88%));
  border-bottom: 1px solid light-dark(#e4e5eb, #30313d);
}

.brand {
  color: inherit;
  font-weight: 750;
  letter-spacing: -0.03em;
  text-decoration: none;
}

.main {
  margin-inline: auto;
  max-width: 76rem;
  padding: 2rem 1rem 4rem;
}

.navLink {
  color: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
}

@media (max-width: 48rem) {
  .main {
    padding-top: 1.25rem;
  }
}
