import Config

config :__APP__, __MODULE__.Repo,
  username: "postgres",
  password: "postgres",
  hostname: "localhost",
  database: "__APP___dev",
  stacktrace: true,
  show_sensitive_data_on_connection_error: true,
  pool_size: 10

config :__APP__, __WEB_MODULE__.Endpoint,
  http: [ip: {127, 0, 0, 1}],
  check_origin: ["//localhost:4000", "//127.0.0.1:4000"],
  code_reloader: true,
  debug_errors: true,
  secret_key_base: "local-development-secret-key-base-that-is-never-used-in-production-000000000000",
  static_url: [host: "localhost", port: 5173],
  watchers: [vite: {PhoenixVite.Npm, :run, [:vite, ~w(dev)]}]

config :__APP__, :secure_browser_headers, %{
  "content-security-policy" =>
    "default-src 'self'; base-uri 'self'; connect-src 'self' http://localhost:5173 ws://localhost:5173; font-src 'self' data: http://localhost:5173; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: http://localhost:5173; object-src 'none'; script-src 'self' 'unsafe-eval' http://localhost:5173; style-src 'self' http://localhost:5173; style-src-attr 'unsafe-inline'",
  "permissions-policy" => "camera=(), geolocation=(), microphone=()",
  "referrer-policy" => "strict-origin-when-cross-origin",
  "x-content-type-options" => "nosniff",
  "x-frame-options" => "DENY"
}

config :__APP__, __MODULE__.Mailer,
  adapter: Swoosh.Adapters.SMTP,
  relay: "localhost",
  port: 1025,
  tls: :never,
  auth: :never

config :__APP__, dev_routes: true
config :__APP__, dev_personas: true
config :hammer, backend: {Hammer.Backend.ETS, [expiry_ms: 60_000 * 60, cleanup_interval_ms: 60_000]}
config :logger, :default_formatter, format: "[$level] $message\n"
config :phoenix, :stacktrace_depth, 20
config :phoenix, :plug_init_mode, :runtime
