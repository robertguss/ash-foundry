import Config

config :__APP__, __WEB_MODULE__.Endpoint,
  cache_static_manifest: "priv/static/cache_manifest.json",
  force_ssl: [
    hsts: true,
    subdomains: false,
    preload: false,
    rewrite_on: [:x_forwarded_proto],
    exclude: [hosts: ["localhost", "127.0.0.1"], paths: ["/healthz", "/readyz"]]
  ]

config :__APP__, secure_session_cookie: true
config :__APP__, dev_routes: false
config :__APP__, dev_personas: false
config :swoosh, local: false

config :logger, :default_handler,
  formatter:
    {LoggerJSON.Formatters.Basic,
     metadata: [:request_id, :job_id, :organization_id], timestamp: :time}
