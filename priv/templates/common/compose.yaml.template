name: __APP__-development

services:
  postgres:
    image: postgres:18.6-bookworm
    environment:
      POSTGRES_DB: __APP___dev
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d __APP___dev"]
      interval: 2s
      timeout: 3s
      retries: 20
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/18/docker

  mailpit:
    image: axllent/mailpit:v1.31.0
    environment:
      MP_MAX_MESSAGES: "1000"
    ports:
      - "1025:1025"
      - "8025:8025"

volumes:
  postgres-data:
