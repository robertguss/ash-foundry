services:
  - type: web
    name: __APP__
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerCommand: /app/bin/server
    preDeployCommand: /app/bin/migrate
    healthCheckPath: /readyz
    maxShutdownDelaySeconds: 120
    autoDeployTrigger: "off"
    envVars:
      - key: PHX_SERVER
        value: "true"
      - key: DATABASE_URL
        fromDatabase:
          name: __APP__-db
          property: connectionString
      - key: POOL_SIZE
        value: "10"
      - key: PHX_HOST
        sync: false
      - key: SECRET_KEY_BASE
        generateValue: true
      - key: METRICS_TOKEN
        generateValue: true
__IF_AUTH__
      - key: TOKEN_SIGNING_SECRET
        generateValue: true
__END_AUTH__
__IF_GOOGLE__
      - key: GOOGLE_CLIENT_ID
        sync: false
      - key: GOOGLE_CLIENT_SECRET
        sync: false
      - key: GOOGLE_REDIRECT_URI
        sync: false
__END_GOOGLE__
      - key: RESEND_API_KEY
        sync: false
      - key: RESEND_WEBHOOK_SECRET
        sync: false
      - key: EMAIL_FROM
        sync: false
      - key: SENTRY_DSN
        sync: false

databases:
  - name: __APP__-db
    databaseName: __APP__
    user: __APP__
    postgresMajorVersion: "18"
    ipAllowList: []
