defmodule __MODULE__.Accounts.Changes.ClearProviderTokens do
  @moduledoc false
  use Ash.Resource.Change

  @impl true
  def change(changeset, _options, _context) do
    Enum.reduce([:access_token, :access_token_expires_at, :refresh_token], changeset, fn attribute, acc ->
      Ash.Changeset.force_change_attribute(acc, attribute, nil)
    end)
  end
end
