defmodule __MODULE__.Accounts.User.Senders.SendMagicLinkEmail do
  @moduledoc false
  use AshAuthentication.Sender

  alias __MODULE__.Accounts.AuthEmail

  @impl true
  def send(user_or_email, token, _options) do
    email = if is_map(user_or_email), do: user_or_email.email, else: user_or_email
    url = AuthEmail.url("/magic_link/" <> URI.encode_www_form(token))
    text = "Use this single-use link to sign in: #{url}"
    html = "<p>Use this single-use link to sign in:</p><p><a href=\"#{url}\">#{url}</a></p>"
    AuthEmail.deliver(email, "Your sign-in link", text, html, token)
  end
end
