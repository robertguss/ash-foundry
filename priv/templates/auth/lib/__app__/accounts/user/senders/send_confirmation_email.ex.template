defmodule __MODULE__.Accounts.User.Senders.SendConfirmationEmail do
  @moduledoc false
  use AshAuthentication.Sender

  alias __MODULE__.Accounts.AuthEmail

  @impl true
  def send(user, token, options) do
    url = AuthEmail.url("/confirm_new_user/" <> URI.encode_www_form(token))

    {subject, purpose} =
      case options[:confirmation_type] do
        :identity_link -> {"Confirm linking your provider login", "link that provider identity"}
        _other -> {"Confirm your email address", "confirm your account"}
      end

    text = "Use this single-use link to #{purpose}: #{url}"
    html = "<p>Use this single-use link to #{purpose}:</p><p><a href=\"#{url}\">#{url}</a></p>"
    AuthEmail.deliver(user.email, subject, text, html, token)
  end
end
