defmodule __MODULE__.Accounts.User.Senders.SendPasswordResetEmail do
  @moduledoc false
  use AshAuthentication.Sender

  alias __MODULE__.Accounts.AuthEmail

  @impl true
  def send(user, token, _options) do
    url = AuthEmail.url("/password-reset/" <> URI.encode_www_form(token))
    text = "Use this single-use link to reset your password: #{url}"
    html = "<p>Use this single-use link to reset your password:</p><p><a href=\"#{url}\">#{url}</a></p>"
    AuthEmail.deliver(user.email, "Reset your password", text, html, token)
  end
end
