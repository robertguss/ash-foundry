defmodule __MODULE__.Accounts do
  @moduledoc "Accounts, persisted authentication identities, and bearer invitations."
  use Ash.Domain, otp_app: :__APP__

  @pending_invitation_key {__MODULE__, :pending_invitation_id}

  resources do
    resource __MODULE__.Accounts.User
    resource __MODULE__.Accounts.Token
    resource __MODULE__.Accounts.Invitation
__IF_GOOGLE__
    resource __MODULE__.Accounts.UserIdentity
__END_GOOGLE__
  end

  defdelegate create_system_admin_invitation(email),
    to: __MODULE__.Accounts.InvitationService

  defdelegate issue_invitation(attributes, actor),
    to: __MODULE__.Accounts.InvitationService,
    as: :issue

  defdelegate verify_invitation(id, token),
    to: __MODULE__.Accounts.InvitationService,
    as: :verify

  defdelegate complete_invitation(invitation_id, user),
    to: __MODULE__.Accounts.InvitationService,
    as: :complete

  @doc "Makes a previously verified invitation available to the current authentication request."
  @spec put_pending_invitation(String.t() | nil) :: :ok
  def put_pending_invitation(invitation_id) do
    Process.put(@pending_invitation_key, invitation_id)
    :ok
  end
end
