defmodule __MODULE__.RateLimit do
  @moduledoc false
  use Hammer, backend: :ets, algorithm: :fix_window_per_key
end

defmodule __WEB_MODULE__.Plugs.AuthRateLimit do
  @moduledoc "Fails sensitive routes closed under trusted-IP and, when present, normalized-identifier limits."
  import Plug.Conn

  @window_milliseconds :timer.seconds(60)
  @ip_limit 30
  @identifier_limit 10

  def init(options), do: options

  def call(conn, _options) do
    ip_key = "auth:ip:" <> hash(ip_string(conn))

    with {:allow, _count} <- __MODULE__.RateLimit.hit(ip_key, @window_milliseconds, @ip_limit),
         :ok <- limit_identifier(conn.params) do
      conn
    else
      _denial -> conn |> send_resp(:too_many_requests, "request could not be completed") |> halt()
    end
  rescue
    _error -> conn |> send_resp(:service_unavailable, "request could not be completed") |> halt()
  catch
    :exit, _reason -> conn |> send_resp(:service_unavailable, "request could not be completed") |> halt()
  end

  defp limit_identifier(params) do
    case identifier_email(params) do
      nil ->
        :ok

      email ->
        case __MODULE__.RateLimit.hit(
               "auth:id:" <> hash(email),
               @window_milliseconds,
               @identifier_limit
             ) do
          {:allow, _count} -> :ok
          denial -> denial
        end
    end
  end

  defp identifier_email(params) do
    value =
      params["email"] || get_in(params, ["user", "email"]) || get_in(params, ["password", "email"])

    case value do
      email when is_binary(email) ->
        email |> String.trim() |> String.downcase() |> presence()

      _other ->
        nil
    end
  end

  defp presence(""), do: nil
  defp presence(value), do: value

  defp ip_string(conn), do: conn.remote_ip |> :inet.ntoa() |> to_string()

  defp hash(value), do: :crypto.hash(:sha256, "__APP__:rate-limit:" <> value) |> Base.url_encode64(padding: false)
end
